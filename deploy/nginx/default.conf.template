# Load balancer in front of the payment replicas. Same config for every variant; only the upstream names change.
upstream payment {
    server ${UPSTREAM_1}:8080 max_fails=1 fail_timeout=2s;
    server ${UPSTREAM_2}:8080 max_fails=1 fail_timeout=2s;
    keepalive 256;
}
server {
    listen 80;
    location / {
        proxy_pass http://payment;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_next_upstream error timeout http_502 http_503;
        proxy_connect_timeout 1s;
        proxy_read_timeout 35s;
    }
}
